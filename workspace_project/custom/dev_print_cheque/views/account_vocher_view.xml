<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cheque_formate_form" model="ir.ui.view">
        <field name="name">account.voucher.formate.form.view</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="partner_text"/>
                <field name="text_free"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                 <field name="is_cheque" invisible="True"/>
                   <field name="cheque_formate_id" invisible="is_cheque != True" />
                   <field name="cheque_no" invisible="is_cheque != True"/>
                  <field name="cheque_date" invisible="is_cheque != True"/>
            </xpath>

             <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="%(dev_print_cheque.action_invoice_print_cheque)d"
                        type="action"
                        string="Print Cheque"
                        class="btn-primary"
                        invisible="not show_check_number or state == 'draft'"
                        context="{'default_cheque_no': check_number}"
                        />
            </xpath>

        </field>
    </record>


</odoo>