<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cheque Book Wizard Form View -->
    <record id="view_cheque_book_wizard_form" model="ir.ui.view">
        <field name="name">cheque.book.wizard.form</field>
        <field name="model">cheque.book.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Cheque Book">
                <sheet>
                    <!-- Smart Features Section -->
                    <group string="Smart Features" name="smart_features">
                        <group>
                            <field name="auto_calculate_range" string="Auto Calculate Range"/>
                            <field name="use_smart_name" string="Use Smart Name"/>
                            <field name="smart_name" string="Smart Name" readonly="1" 
                                   invisible="not use_smart_name"/>
                        </group>
                        <group>
                            <field name="suggested_range" string="Suggested Range" readonly="1"/>
<!--                            <field name="total_cheques" string="Total Cheques" readonly="1"/>-->
                        </group>
                    </group>
                    
                    <!-- Action Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_auto_fill_range" 
                                type="object" 
                                class="btn-primary" 
                                string="Auto Fill Range"
                                icon="fa-magic"
                                help="Automatically fill the cheque number range based on suggestion"
                                invisible="not suggested_range"/>
                        <button name="action_validate_range" 
                                type="object" 
                                class="btn-info" 
                                string="Validate Range"
                                icon="fa-check"
                                help="Validate the current cheque number range"
                                invisible="not first_cheque_no or not last_cheque_no"/>
                        <button name="action_show_existing_books" 
                                type="object" 
                                class="btn-secondary" 
                                string="Show Existing Books"
                                icon="fa-list"
                                help="Show detailed information about existing cheque books"
                                invisible="not journal_id"/>
                        <button name="action_debug_info" 
                                type="object" 
                                class="btn-info" 
                                string="Debug Info"
                                icon="fa-bug"
                                help="Show debug information about the wizard state"/>
                    </div>
                    
                    <!-- Basic Information Section -->
                    <group string="Basic Information" name="basic_info">
                        <group>
                            <field name="name" invisible="use_smart_name"/>
                            <field name="journal_id" options="{'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="bank_account_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="first_cheque_no"/>
                            <field name="last_cheque_no"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Existing Books Information Section -->
                    <group string="Existing Books Information" name="existing_books_info" 
                           invisible="not existing_books_info">
                        <field name="existing_books_info" readonly="1" nolabel="1" 
                               widget="text" style="height: 100px;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_cheque_book" string="Create Cheque Book" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cheque Book Wizard Action -->
    <record id="action_cheque_book_wizard" model="ir.actions.act_window">
        <field name="name">Create Cheque Book</field>
        <field name="res_model">cheque.book.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo> 