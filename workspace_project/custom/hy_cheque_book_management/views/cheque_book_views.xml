<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cheque Book Form View -->
    <record id="view_cheque_book_form" model="ir.ui.view">
        <field name="name">cheque.book.form</field>
        <field name="model">cheque.book</field>
        <field name="arch" type="xml">
            <form string="Cheque Book">
                <header>
                    <button name="action_complete" string="Complete" type="object" 
                            class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_reactivate" string="Reactivate" type="object" 
                            class="oe_highlight" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence" widget="handle"/>
                            <field name="journal_id" options="{'no_create': 1, 'no_create_edit': 1}"/>
                            <field name="bank_account_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="first_cheque_no"/>
                            <field name="last_cheque_no"/>
                            <field name="current_cheque_no" readonly="1"/>
                            <field name="total_cheques" readonly="1"/>
                            <field name="used_cheques" readonly="1"/>
                            <field name="available_cheques" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Used Cheque Numbers" name="used_cheques">
                            <field name="used_cheque_numbers" readonly="1">
                                <list>
                                    <field name="cheque_number"/>
                                    <field name="pdc_id"/>
                                    <field name="partner_id"/>
                                    <field name="payment_amount"/>
                                    <field name="used_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Cheque Book Tree View -->
    <record id="view_cheque_book_tree" model="ir.ui.view">
        <field name="name">cheque.book.tree</field>
        <field name="model">cheque.book</field>
        <field name="arch" type="xml">
            <list string="Cheque Books" default_order="sequence,create_date desc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bank_account_id"/>
                <field name="journal_id" string="Bank Account"/>
                <field name="first_cheque_no"/>
                <field name="last_cheque_no"/>
                <field name="current_cheque_no"/>
                <field name="total_cheques"/>
                <field name="used_cheques"/>
                <field name="available_cheques"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Cheque Book Search View -->
    <record id="view_cheque_book_search" model="ir.ui.view">
        <field name="name">cheque.book.search</field>
        <field name="model">cheque.book</field>
        <field name="arch" type="xml">
            <search string="Search Cheque Books">
                <field name="name"/>
                <field name="bank_account_id"/>
                <field name="journal_id" string="Bank Account"/>
                <field name="company_id" invisible="1"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Available Cheques" name="available" domain="[('available_cheques', '>', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bank Account" name="group_bank" context="{'group_by': 'bank_account_id'}"/>
                    <filter string="Bank Account Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Cheque Book Action -->
    <record id="action_cheque_book" model="ir.actions.act_window">
        <field name="name">Cheque Books</field>
        <field name="res_model">cheque.book</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cheque_book_tree"/>
        <field name="search_view_id" ref="view_cheque_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cheque book!
            </p>
            <p>
                Manage cheque books for different bank accounts with first and last cheque numbers.
                You can create multiple cheque books for the same account and control their usage order using the sequence field.
            </p>
        </field>
    </record>

    <!-- Cheque Book Menu -->
    <menuitem id="menu_cheque_book_config"
              name="Cheque Books Configurations"
              parent="account.menu_finance_configuration"
              sequence="26"
              groups="account.group_account_invoice"/>

    <menuitem id="menu_cheque_book"
              name="Cheque Books"
              parent="menu_cheque_book_config"
              action="action_cheque_book"
              sequence="26"
              groups="account.group_account_invoice"/>

</odoo> 
