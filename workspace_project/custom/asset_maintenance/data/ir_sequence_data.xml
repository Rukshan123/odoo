<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Asset Serial Number Sequence -->
        <record id="seq_account_asset_serial" model="ir.sequence">
            <field name="name">Asset Serial Number</field>
            <field name="code">account.asset.serial</field>
            <field name="prefix">ASN/</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>