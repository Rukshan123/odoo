<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_quotation_download" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.quotation.download</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add the download quotation button in the header -->
            <xpath expr="//button[@name='action_preview_sale_order']" position="after">
                <button name="action_download_quotation_pdf" 
                        string="Download Quotation" 
                        type="object" 
                        class="btn-secondary"
                        icon="fa-download"
                        invisible="state not in ['draft', 'sent']"/>
            </xpath>
        </field>
    </record>
</odoo>
