<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_simple_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        
        <!-- Custom Layout - Compact design -->
        <main style="font-family: Arial, sans-serif; margin: 0; padding: 5px; max-width: 800px;">
            
            <!-- Simple Header Section - No Images -->
            <div style="text-align: center; margin-bottom: 5px; ">
                <div style="font-size: 28px; font-weight: bold; margin-bottom: 5px; color: #2c3e50;">
                    JANITHA HYDRAULIC INTERNATIONAL (PVT) LTD.
                </div>
                <div style="font-size: 14px; margin-bottom: 5px; color: #34495e;">
                    #156, PANNIPITIYA ROAD, KALALGODA, THALAWATHUGODA - (10116), SRI LANKA.
                </div>
                <div style="font-size: 12px; margin-bottom: 10px; color: #7f8c8d;">
                    Tel: (+94)112171245, (+94)777658562 | Fax: (+94)112796726<br/>
                    Email: janitha@jhi.lk | Web: www.jhi.lk
                </div>
                <div style="font-size: 20px; font-weight: bold; margin-bottom: 5px; color: #e74c3c; border-bottom: 2px solid #e74c3c; padding-bottom: 10px;">
                    QUOTATION
                </div>
            </div>

            <!-- Quotation Details and Date -->
            <div class="row mb-2">
                <div class="col-6">
                    <div style="font-size: 14px;">
                        <strong>Date:</strong> <span t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                    </div>
                </div>
                <div class="col-6 text-end">
                    <div style="font-size: 14px;">
                        <strong>Quotation No:</strong> <span t-field="doc.name"/><br/>
                        <strong>SE Code:</strong> RC007<br/>
                        <strong>Attn:</strong> <span t-field="doc.partner_id.name"/>
                    </div>
                </div>
            </div>

            <hr style="border: 1px solid #000; margin: 5px 0;"/>

            <!-- Subject and Introduction -->
            <div class="row mb-3">
                <div class="col-12">
                    <div style="font-size: 16px; font-weight: bold; text-decoration: underline; margin-bottom: 10px; color: #2c3e50;">
                        Quotation for the supply of <span t-field="doc.name"/>
                    </div>
                    <div style="font-size: 14px; margin-bottom: 20px; color: #34495e;">
                        With reference to your valuable enquiry on the above, we are pleased to submit our offer as follows for your kind consideration please.
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="row mb-4">
                <div class="col-12">
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
                        <thead>
                            <tr style="background-color: #f8f9fa;">
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: left; width: 20%; background-color: #e9ecef;">Item Code</th>
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: left; width: 40%; background-color: #e9ecef;">Description</th>
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: center; width: 10%; background-color: #e9ecef;">UOM</th>
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: center; width: 10%; background-color: #e9ecef;">Qty</th>
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: right; width: 10%; background-color: #e9ecef;">Unit Price</th>
                                <th style="border: 1px solid #ddd; padding: 6px; text-align: right; width: 10%; background-color: #e9ecef;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.order_line" t-as="line">
                                <td style="border: 1px solid #ddd; padding: 6px;">
                                    <span t-field="line.product_id.default_code" t-if="line.product_id.default_code"/>
                                    <span t-if="not line.product_id.default_code">-</span>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 6px;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 6px; text-align: center;">
                                    <span t-field="line.product_uom.name"/>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 6px; text-align: center;">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 6px; text-align: right;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 6px; text-align: right;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Summary of Charges -->
            <div class="row mb-4">
                <div class="col-8"></div>
                <div class="col-4">
                    <table style="width:100%; margin-top:10px; border-collapse: collapse;">
                        <tr>
                            <td style="text-align:left; padding:2px; white-space:nowrap;"><strong>Total:</strong></td>
                            <td style="text-align:right; padding:2px;">
                                <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:left; padding:2px; white-space:nowrap;"><strong>Discount:</strong></td>
                            <td style="text-align:right; padding:2px;">0.00</td>
                        </tr>
                        <tr>
                            <td style="text-align:left; padding:2px; white-space:nowrap;"><strong>Sub Total:</strong></td>
                            <td style="text-align:right; padding:2px;">
                                <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:left; padding:2px; white-space:nowrap;"><strong>V.A.T. 18%:</strong></td>
                            <td style="text-align:right; padding:2px;">
                                <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr style="border-top: 2px solid #000;">
                            <td style="text-align:left; padding:2px; white-space:nowrap;"><strong>Grand Total:</strong></td>
                            <td style="text-align:right; padding:2px; font-weight:bold; text-decoration:underline; color:#e74c3c;">
                                <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Terms and Conditions -->
            <div class="row mb-4">
                <div class="col-12">
                    <div style="font-size: 14px; background-color: #f8f9fa; padding: 12px; border-radius: 5px;">
                        <strong>Validity:</strong> 14 days from date of quotation<br/><br/>
                        <strong>Warranty:</strong> <br/><br/>
                        <strong>Delivery:</strong> Ex-Stock subject to prior sale<br/><br/>
                        <strong>Term of Payment:</strong> Full payment on collection<br/><br/>
                        <strong>V.A.T Registration No:</strong> 101000273-7000<br/><br/>
                        <strong>S.V.A.T Registration No:</strong> 11073<br/><br/>
                        
                        <strong>Note:</strong> Orders will be executed only against confirmed written purchase orders, received within the validity period of offer.<br/><br/>
                        
                        Trust the above offer meets with your approval and look forward to receiving your valued order soon. For any further clarification, please contact the undersigned.<br/><br/>
                        
                        Thanking you and assuring you of our best services at all occasions.<br/><br/>
                        
                        <strong>Yours faithfully,</strong><br/>
                        <strong>For Janitha Hydraulic International (Pvt) Ltd.</strong>
                    </div>
                </div>
            </div>

            <!-- Company Representative Contact -->
            <div class="row mb-4">
                <div class="col-12">
                    <div style="font-size: 14px; text-align: left; padding: 12px; padding-top: 5px; padding-bottom: 1px; border-radius: 5px;">
                        <strong style="color: #2c3e50;">MENUKA PREMARATHNA</strong><br/>
                        <strong style="color: #2c3e50;">MARKETING MANAGER</strong><br/>
                        <strong>Contact No:</strong> 0704439566<br/>
                        <strong>E-mail:</strong> sales@jhi.lk<br/><br/>
                        
                        <em style="color: #7f8c8d;">This is a computer generated document, no signature is required.</em>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div style="text-align: center; border-top: 1px solid #000; padding-top: 5px;">
                <div style="font-size: 12px; color: #7f8c8d;">
                    We undertake all brands of Hand pallet trucks Stackere Corklift tuumend
                </div>
            </div>
        </main>
    </template>

    <template id="report_simple_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="quotation_pdf_downloader.report_simple_quotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>