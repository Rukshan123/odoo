<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add button to invoice line form view -->
    <record id="view_move_line_form_inherit_asset" model="ir.ui.view">
        <field name="name">account.move.line.form.inherit.asset</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Asset Creation" invisible="move_id.move_type != 'in_invoice'">
                    <button name="action_create_assets_from_line" 
                            string="Create Assets" 
                            type="object" 
                            class="btn-primary"
                            invisible="product_id == False or quantity &lt;= 0"
                            help="Create assets from this invoice line"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo> 